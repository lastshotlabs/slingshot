{
  "name": "@lastshotlabs/slingshot-entity",
  "version": "0.4.0",
  "description": "Config-driven entity CRUD, code generation, and search for Slingshot",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./routing": {
      "bun": "./dist/src/routing/index.js",
      "types": "./dist/src/routing/index.d.ts",
      "import": "./dist/src/routing/index.js"
    },
    "./seeder": {
      "bun": "./dist/src/seeder/index.js",
      "types": "./dist/src/seeder/index.d.ts",
      "import": "./dist/src/seeder/index.js"
    },
    "./testing": {
      "bun": "./dist/src/testing.js",
      "types": "./dist/src/testing.d.ts",
      "import": "./dist/src/testing.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lastshotlabs/slingshot.git",
    "directory": "packages/slingshot-entity"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --cache"
  },
  "dependencies": {
    "@faker-js/faker": ">=10.0 <11",
    "@lastshotlabs/slingshot-core": "workspace:*"
  },
  "peerDependencies": {
    "@hono/zod-openapi": ">=0.18",
    "hono": ">=4.12.14 <5",
    "ioredis": ">=5 <6",
    "mongoose": ">=9.0 <10",
    "pg": ">=8.20 <9",
    "zod": ">=4.0 <5"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
