{
  "name": "@lastshotlabs/slingshot-events",
  "version": "0.3.0",
  "description": "Transactional outbox and inbox reliability for Slingshot events",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lastshotlabs/slingshot.git",
    "directory": "packages/slingshot-events"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --cache",
    "test": "bun test",
    "coverage": "bun test --coverage"
  },
  "dependencies": {
    "@lastshotlabs/slingshot-core": "workspace:*",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
