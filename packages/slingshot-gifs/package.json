{
  "name": "@lastshotlabs/slingshot-gifs",
  "version": "0.3.1",
  "description": "GIF search proxy for Slingshot — swappable providers (Giphy, KLIPY, Tenor), server-side API key",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lastshotlabs/slingshot.git",
    "directory": "packages/slingshot-gifs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --cache"
  },
  "dependencies": {
    "@lastshotlabs/slingshot-core": "workspace:*"
  },
  "peerDependencies": {
    "hono": ">=4.12.14 <5",
    "zod": ">=4.0 <5"
  },
  "engines": {
    "node": ">=20"
  }
}
